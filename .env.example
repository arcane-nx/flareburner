# flareburner configuration — copy to .env and edit.
# All values are optional; sensible defaults are shown.

# Port the HTTP API listens on.
PORT=4001

# Optional API key. If set, POST /v1 requires:
#   X-API-Key: <key>            (or)   Authorization: Bearer <key>
# Leave empty to keep the API open.
API_KEY=

# Number of warm Chrome instances (max concurrent requests).
POOL_SIZE=1

# Run Chrome headless. Cloudflare is harder to beat headless; keep false
# unless you know your target doesn't challenge.
HEADLESS=false

# Navigation + Cloudflare-wait timeout, in milliseconds.
NAV_TIMEOUT=60000

# URL used when a request omits "url".
DEFAULT_URL=

# Maximum request body size in bytes (default 2MB = 2097152).
MAX_BODY_SIZE=2097152

# Optional upstream proxy (HTTP or SOCKS5) for all outgoing Chrome traffic.
# Format: http://host:port, http://user:pass@host:port, socks5://host:port
PROXY_URL=

# Maximum requests per browser slot before recycling (restarting Chrome to free memory).
MAX_REQUESTS_PER_SLOT=50

# Maximum lifetime of a browser slot in milliseconds (default 1 hour = 3600000).
MAX_SLOT_LIFETIME_MS=3600000

# Stateful session inactivity timeout in milliseconds (default 15 minutes = 900000).
SESSION_TTL=900000

# Block images, fonts, and media files during navigation for 2-5x faster solve times.
# Set true or false (default false to maintain maximum Turnstile compatibility).
BLOCK_RESOURCES=false
